# Normalize line endings: text files use LF on commit/checkout.
* text=auto eol=lf

# Explicit text types
*.go text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files (never normalize)
*.exe binary
*.dll binary
*.so binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.key binary
*.p12 binary
*.jks binary